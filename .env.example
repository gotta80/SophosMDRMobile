# ---- Server ----
PORT=3456
# In Docker it is already 0.0.0.0 (port published only on 127.0.0.1 by the compose file). Locally: 127.0.0.1, or 0.0.0.0 to test from an iPhone on Wi-Fi.
HOST=127.0.0.1

# ---- App access ----
# PIN/password required on open (HttpOnly session cookie)
APP_ACCESS_PIN=change-me
# Key used to sign the session cookies (recommended: a long random string). If empty, sessions are lost on every restart.
# Generate it with:  openssl rand -hex 32
SESSION_SECRET=
SESSION_DAYS=30

# ---- Proxy / HTTPS ----
# true behind an HTTPS reverse proxy (reads X-Forwarded-*)
TRUST_PROXY=true
# Cookie "Secure": default 'auto' = enabled only if the request is HTTPS (proxy), so login also works from the LAN over HTTP.
# COOKIE_SECURE=auto
# IP on which the compose file publishes port 3456 (default 127.0.0.1). E.g. the server's LAN IP for LAN access.
BIND_IP=127.0.0.1

# ---- Demo mode ----
# true = fake data, no calls to Sophos
MOCK_MODE=true

# ---- Sophos Central (API credentials: Central > Global Settings > API Credentials Management) ----
SOPHOS_CLIENT_ID=
SOPHOS_CLIENT_SECRET=
# Additional credentials (up to _6), e.g. a Partner credential covering several customers: the app lists the reachable
# tenants for each one and picks the right connection by itself (Fusion or classic Sophos Central).
# SOPHOS_CLIENT_ID_2=
# SOPHOS_CLIENT_SECRET_2=
# Only with Partner/Organization credentials: ID of the tenant to query
SOPHOS_TENANT_ID=
# Cases GraphQL endpoint (official default, the same for all tenants)
# SOPHOS_GRAPHQL_URL=https://api.taegis.sophos.com/graphql
# authorIds of the comments written by you (comma-separated), to color them as "yours" in the chat.
# The API client id is already included; add other IDs here if your comments show up as "Sophos MDR".
# SOPHOS_MY_AUTHOR_IDS=
