# ---- Server ----
PORT=3456
# In Docker è già 0.0.0.0 (porta pubblicata solo su 127.0.0.1 dal compose). In locale: 127.0.0.1, oppure 0.0.0.0 per test da iPhone in Wi-Fi.
HOST=127.0.0.1

# ---- Accesso all'app ----
# PIN/password richiesta all'apertura (cookie di sessione HttpOnly)
APP_ACCESS_PIN=change-me
# Chiave per firmare i cookie di sessione (consigliata: stringa casuale lunga). Se vuota, le sessioni decadono ad ogni riavvio.
# Generala con:  openssl rand -hex 32
SESSION_SECRET=
SESSION_DAYS=30

# ---- Proxy / HTTPS ----
# true dietro un reverse proxy HTTPS (legge X-Forwarded-*)
TRUST_PROXY=true
# Cookie "Secure": default 'auto' = attivo solo se la richiesta è HTTPS (proxy), così il login funziona anche da LAN in HTTP.
# COOKIE_SECURE=auto
# IP su cui il compose pubblica la porta 3456 (default 127.0.0.1). Es. IP LAN del server per l'accesso dalla LAN.
BIND_IP=127.0.0.1

# ---- Modalità demo ----
# true = dati finti, nessuna chiamata a Sophos
MOCK_MODE=true

# ---- Sophos Central (API credentials: Central > Global Settings > API Credentials Management) ----
SOPHOS_CLIENT_ID=
SOPHOS_CLIENT_SECRET=
# Credenziali aggiuntive (fino a _6), es. una credenziale Partner per più clienti: l'app elenca i tenant
# raggiungibili con ciascuna e sceglie da sola la connessione giusta (Fusion o Sophos Central classic).
# SOPHOS_CLIENT_ID_2=
# SOPHOS_CLIENT_SECRET_2=
# Solo con credenziali Partner/Organization: ID del tenant da interrogare
SOPHOS_TENANT_ID=
# Endpoint Cases GraphQL (default ufficiale, unico per tutti i tenant)
# SOPHOS_GRAPHQL_URL=https://api.taegis.sophos.com/graphql
# authorId dei commenti scritti da te (separati da virgola), per colorarli come "tuoi" nella chat.
# Il client id API è già incluso; aggiungi qui altri ID se i tuoi commenti risultano come "Sophos MDR".
# SOPHOS_MY_AUTHOR_IDS=
